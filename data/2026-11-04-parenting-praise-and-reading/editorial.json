    {
      "start": 256.32,
      "end": 257.56,
      "text": "你很努力的去撿"
    },
    {
      "start": 257.56,
      "end": 258.52,
      "text": "然後又繼續玩"
    },
    {
      "start": 258.52,
      "end": 259.35999999999996,
      "text": "感動"
    },
    {
      "start": 259.35999999999996,
      "end": 260.56,
      "text": "對對很"
    },
    {
      "start": 260.56,
      "end": 261.32,
      "text": "很鍥而不捨"
    },
    {
      "start": 261.32,
      "end": 262.35999999999996,
      "text": "或者很努力的小孩"
    },
    {
      "start": 262.35999999999996,
      "end": 264.35999999999996,
      "text": "最後你也要讓你的孩子知道"
    },
    {
      "start": 264.35999999999996,
      "end": 265.88,
      "text": "你看到他的人格什麼特質"
    },
    {
      "start": 265.88,
      "end": 268.0,
      "text": "因為最後會留下來是"
