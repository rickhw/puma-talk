    {
      "start": 251.04000000000002,
      "end": 252.28,
      "text": "你又看到了"
    },
    {
      "start": 252.28,
      "end": 253.62,
      "text": "剛才他做了什麼事情"
    },
    {
      "start": 253.62,
      "end": 254.62,
      "text": "你可以講出來"
    },
    {
      "start": 254.62,
      "end": 256.32,
      "text": "剛剛看到你那個球掉了之後"
