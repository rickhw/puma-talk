  {
    "start": 189.9,
    "end": 191.45999999999998,
    "text": "大卫跟哥利亚的感觉"
  },
  {
    "start": 191.45999999999998,
    "end": 193.2,
    "text": "他也跟我开个玩笑说"
  },
  {
    "start": 193.2,
    "end": 194.18,
    "text": "因为那边有一个"
  },
  {
    "start": 194.18,
    "end": 195.48,
    "text": "被打掉的洗衣机"
  },
  {
    "start": 195.48,
    "end": 196.74,
    "text": "在那边"
