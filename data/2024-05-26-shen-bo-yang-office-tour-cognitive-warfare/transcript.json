[
  {
    "start": 0.0,
    "end": 0.84,
    "text": "各位好朋友"
  },
  {
    "start": 0.84,
    "end": 3.04,
    "text": "我是立法委員林俊憲"
  },
  {
    "start": 3.04,
    "end": 5.04,
    "text": "開箱國會"
  },
  {
    "start": 5.04,
    "end": 7.3,
    "text": "新的一季開箱國會"
  },
  {
    "start": 7.3,
    "end": 11.24,
    "text": "因為我們這一屆的新的國會開始了"
  },
  {
    "start": 11.24,
    "end": 14.34,
    "text": "那也有很多新的立法委員"
  },
  {
    "start": 14.34,
    "end": 19.76,
    "text": "今天要先來開箱誰的辦公室呢"
  },
  {
    "start": 19.76,
    "end": 21.32,
    "text": "沈柏洋"
  },
  {
    "start": 21.32,
    "end": 22.76,
    "text": "一開始國會表現"
  },
  {
    "start": 22.76,
    "end": 26.92,
    "text": "就非常突出優秀的沈柏洋立委"
  },
  {
    "start": 26.92,
    "end": 30.0,
    "text": "他的辦公室會是什麼樣子呢"
  },
  {
    "start": 30.0,
    "end": 31.0,
    "text": "很好奇吧"
  },
  {
    "start": 31.0,
    "end": 32.0,
    "text": "跟我來"
  },
  {
    "start": 36.0,
    "end": 38.0,
    "text": "哈囉哈囉"
  },
  {
    "start": 38.0,
    "end": 39.0,
    "text": "沈委員好"
  },
  {
    "start": 39.0,
    "end": 40.0,
    "text": "你好"
  },
  {
    "start": 40.0,
    "end": 41.0,
    "text": "柏仔你好"
  },
  {
    "start": 41.0,
    "end": 42.0,
    "text": "你好"
  },
  {
    "start": 42.0,
    "end": 43.0,
    "text": "各位同仁大家好"
  },
  {
    "start": 43.0,
    "end": 46.0,
    "text": "我們已經進來沈委員的辦公室了"
  },
  {
    "start": 46.0,
    "end": 47.0,
    "text": "委員你好"
  },
  {
    "start": 47.0,
    "end": 48.0,
    "text": "你好 委員好"
  },
  {
    "start": 48.0,
    "end": 51.0,
    "text": "這是我個人非常崇拜的一個對象"
  },
  {
    "start": 51.0,
    "end": 52.0,
    "text": "沒有沒有沒有"
  },
  {
    "start": 52.0,
    "end": 53.0,
    "text": "你是律師"
  },
  {
    "start": 53.0,
    "end": 54.0,
    "text": "過獎了"
  },
  {
    "start": 54.0,
    "end": 56.0,
    "text": "又在大學教法律"
  },
  {
    "start": 56.0,
    "end": 58.0,
    "text": "對 教法律跟犯罪學"
  },
  {
    "start": 58.0,
    "end": 59.3,
    "text": "謝謝"
  },
  {
    "start": 59.3,
    "end": 61.4,
    "text": "又是黑熊學院的"
  },
  {
    "start": 61.4,
    "end": 62.4,
    "text": "院長"
  },
  {
    "start": 62.4,
    "end": 64.1,
    "text": "很久不見院長"
  },
  {
    "start": 64.1,
    "end": 65.8,
    "text": "我們先來看一下"
  },
  {
    "start": 65.8,
    "end": 66.1,
    "text": "沒問題"
  },
  {
    "start": 66.1,
    "end": 67.2,
    "text": "這是我們的"
  },
  {
    "start": 67.2,
    "end": 67.8,
    "text": "這是"
  },
  {
    "start": 67.8,
    "end": 70.1,
    "text": "這很多是我們黑熊的救難"
  },
  {
    "start": 70.1,
    "end": 71.7,
    "text": "黑熊學院的"
  },
  {
    "start": 71.7,
    "end": 72.4,
    "text": "對啦"
  },
  {
    "start": 72.4,
    "end": 72.9,
    "text": "救災包"
  },
  {
    "start": 72.9,
    "end": 73.6,
    "text": "這是口糧"
  },
  {
    "start": 73.6,
    "end": 74.4,
    "text": "戰備口糧"
  },
  {
    "start": 74.4,
    "end": 75.1,
    "text": "對對"
  },
  {
    "start": 75.1,
    "end": 76.8,
    "text": "做過兵的都知道"
  },
  {
    "start": 76.8,
    "end": 78.4,
    "text": "不過你會看起來比較好吃"
  },
  {
    "start": 78.4,
    "end": 80.4,
    "text": "真的 我們這種特殊的調過"
  },
  {
    "start": 80.4,
    "end": 81.5,
    "text": "這個是止血帶"
  },
  {
    "start": 81.5,
    "end": 82.8,
    "text": "民防藝術的加強"
  },
  {
    "start": 82.8,
    "end": 84.2,
    "text": "這個是綠水"
  },
  {
    "start": 84.2,
    "end": 85.8,
    "text": "這個綠水氣很厲害"
  },
  {
    "start": 85.8,
    "end": 86.8,
    "text": "這個很必要"
  },
  {
    "start": 86.8,
    "end": 87.7,
    "text": "野外求生"
  },
  {
    "start": 87.7,
    "end": 89.7,
    "text": "可以綠於一千公升的水"
  },
  {
    "start": 89.7,
    "end": 90.84,
    "text": "台灣的專利"
  },
  {
    "start": 90.84,
    "end": 93.64,
    "text": "它就是鎖在寶特瓶的瓶口上"
  },
  {
    "start": 93.64,
    "end": 94.34,
    "text": "鎖上去之後"
  },
  {
    "start": 94.34,
    "end": 96.14,
    "text": "髒的水直接這樣喝就可以了"
  },
  {
    "start": 96.14,
    "end": 97.14,
    "text": "這是台灣的專利嗎"
  },
  {
    "start": 97.14,
    "end": 97.64,
    "text": "對"
  },
  {
    "start": 97.64,
    "end": 98.14,
    "text": "這麼厲害喔"
  },
  {
    "start": 98.14,
    "end": 99.74000000000001,
    "text": "台灣專利一千公升"
  },
  {
    "start": 99.74000000000001,
    "end": 100.44,
    "text": "大家可以打開"
  },
  {
    "start": 100.44,
    "end": 102.44,
    "text": "這是我們的這個給青少年"
  },
  {
    "start": 102.44,
    "end": 105.06,
    "text": "還有小孩子看的這個民房的書籍"
  },
  {
    "start": 105.06,
    "end": 106.92,
    "text": "還有這個我們跟朋友一起"
  },
  {
    "start": 106.92,
    "end": 108.56,
    "text": "弄的這個阿公打來怎麼辦"
  },
  {
    "start": 108.56,
    "end": 109.72,
    "text": "有第一集跟第二集"
  },
  {
    "start": 109.72,
    "end": 110.92,
    "text": "我有你是共同的作者"
  },
  {
    "start": 110.92,
    "end": 111.62,
    "text": "我第一集是"
  },
  {
    "start": 111.62,
    "end": 113.06,
    "text": "第二集就只是幫忙而已"
  },
  {
    "start": 113.06,
    "end": 114.46000000000001,
    "text": "因為畢竟太忙了"
  },
  {
    "start": 114.46000000000001,
    "end": 116.26,
    "text": "那你應該很快就要上黑名單了"
  },
  {
    "start": 116.26,
    "end": 117.2,
    "text": "上了沒有"
  },
  {
    "start": 117.2,
    "end": 118.16,
    "text": "已經上了已經上了"
  },
  {
    "start": 118.16,
    "end": 119.60000000000001,
    "text": "解放軍的報紙看我很不熟"
  },
  {
    "start": 119.60000000000001,
    "end": 120.9,
    "text": "那是你光榮的勳章"
  },
  {
    "start": 120.9,
    "end": 122.10000000000001,
    "text": "是模樣"
  },
  {
    "start": 122.10000000000001,
    "end": 123.10000000000001,
    "text": "你也是棒球迷"
  },
  {
    "start": 123.10000000000001,
    "end": 124.8,
    "text": "對我很喜歡打棒球"
  },
  {
    "start": 124.8,
    "end": 125.8,
    "text": "要說棒球"
  },
  {
    "start": 125.8,
    "end": 126.9,
    "text": "這跟怎麼很奇怪"
  },
  {
    "start": 126.9,
    "end": 127.60000000000001,
    "text": "可以摸一下嗎"
  },
  {
    "start": 127.60000000000001,
    "end": 128.8,
    "text": "可以可以沒問題"
  },
  {
    "start": 128.8,
    "end": 129.8,
    "text": "這一隻手套了"
  },
  {
    "start": 129.8,
    "end": 130.5,
    "text": "對"
  },
  {
    "start": 130.5,
    "end": 131.5,
    "text": "軟骨軟骨你看"
  },
  {
    "start": 131.5,
    "end": 132.5,
    "text": "沒有沒有"
  },
  {
    "start": 133.2,
    "end": 134.4,
    "text": "再給我看看"
  },
  {
    "start": 135.0,
    "end": 137.1,
    "text": "這個是我們的同仁"
  },
  {
    "start": 137.1,
    "end": 138.3,
    "text": "各位同仁"
  },
  {
    "start": 138.3,
    "end": 139.5,
    "text": "各位帥哥美女"
  },
  {
    "start": 139.5,
    "end": 140.4,
    "text": "大家好"
  },
  {
    "start": 140.4,
    "end": 141.7,
    "text": "不好意思"
  },
  {
    "start": 141.7,
    "end": 143.2,
    "text": "這是我們的會議室"
  },
  {
    "start": 143.2,
    "end": 144.0,
    "text": "這是我們的"
  },
  {
    "start": 144.0,
    "end": 144.9,
    "text": "小小的會議室"
  },
  {
    "start": 144.9,
    "end": 145.5,
    "text": "會議室啊"
  },
  {
    "start": 145.5,
    "end": 146.1,
    "text": "對對對"
  },
  {
    "start": 146.1,
    "end": 147.1,
    "text": "會議室"
  },
  {
    "start": 147.1,
    "end": 149.1,
    "text": "我們白沙特媽祖的酒棒"
  },
  {
    "start": 149.1,
    "end": 151.1,
    "text": "白沙特媽祖"
  },
  {
    "start": 151.1,
    "end": 153.1,
    "text": "你有沒有去跟著走"
  },
  {
    "start": 153.1,
    "end": 155.1,
    "text": "沒有 這次沒有"
  },
  {
    "start": 155.1,
    "end": 157.1,
    "text": "帶來的酒棒"
