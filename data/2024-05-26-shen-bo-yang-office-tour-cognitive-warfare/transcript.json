  {
    "start": 169.1,
    "end": 170.1,
    "text": "烏克蘭的海報"
  },
  {
    "start": 170.1,
    "end": 172.1,
    "text": "你沒有一張海報就不得了"
  },
  {
    "start": 172.1,
    "end": 173.1,
    "text": "這我"
  },
  {
    "start": 173.1,
    "end": 175.1,
    "text": "我去年有去烏克蘭"
  },
  {
    "start": 175.1,
    "end": 177.2,
    "text": "我去年在基辅"
  },
  {
    "start": 177.2,
    "end": 178.29999999999998,
    "text": "所以就是"
  },
  {
    "start": 178.29999999999998,
    "end": 180.14,
    "text": "博洋去年有去乌克蘭"
  },
  {
    "start": 180.14,
    "end": 180.84,
    "text": "去年有在乌克蘭"
  },
  {
    "start": 180.84,
    "end": 181.79999999999998,
    "text": "你有到基辅去"
