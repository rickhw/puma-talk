    "start": 196.74,
    "end": 197.79999999999998,
    "text": "他说这个洗衣机"
  },
  {
    "start": 197.79999999999998,
    "end": 199.12,
    "text": "他说晶片一定是台湾的"
  },
  {
    "start": 199.12,
    "end": 201.72,
    "text": "他跟剧人"
  },
  {
    "start": 201.72,
    "end": 202.66,
    "text": "已经打倒剧人了"
  },
  {
    "start": 202.66,
    "end": 202.9,
    "text": "真的"
  },
  {
    "start": 202.9,
    "end": 203.7,
    "text": "希望"
  },
  {
    "start": 203.7,
    "end": 204.88,
    "text": "还在奋战当中"
  },
  {
    "start": 204.88,
    "end": 206.32,
    "text": "我們都一起在辦烏克蘭家"
  },
  {
    "start": 206.32,
    "end": 206.88,
    "text": "沒錯"
  },
  {
    "start": 207.88,
    "end": 209.32,
    "text": "然後那邊是我的辦公室"
  },
  {
    "start": 209.32,
    "end": 211.32,
    "text": "進到我們沈柏洋委員的辦公室"
  },
  {
    "start": 211.32,
    "end": 212.76,
    "text": "對 我辦公室稍微小一點"
  },
  {
    "start": 212.76,
    "end": 215.2,
    "text": "這個是沙發只是我把它弄平的"
  },
  {
    "start": 215.2,
    "end": 216.35999999999999,
    "text": "這是沙發啦"
  },
  {
    "start": 216.35999999999999,
    "end": 217.79999999999998,
    "text": "那是防彈背心"
  },
  {
    "start": 217.79999999999998,
    "end": 218.92,
    "text": "防彈背心耶"
  },
  {
    "start": 220.2,
    "end": 221.6,
    "text": "隨時有戰備意識"
  },
  {
    "start": 221.6,
    "end": 222.2,
    "text": "對"
  },
  {
    "start": 222.2,
    "end": 223.0,
    "text": "這明天開玩笑了"
  },
  {
    "start": 223.0,
    "end": 223.84,
    "text": "有時候需要"
  },
  {
    "start": 223.84,
    "end": 225.04,
    "text": "對對對"
  },
  {
    "start": 225.04,
    "end": 226.76,
    "text": "那這是我的位置"
  },
  {
    "start": 226.76,
    "end": 227.8,
    "text": "你的辦公室"
  },
  {
    "start": 229.4,
    "end": 231.2,
    "text": "我是覺得很像那個K書中心"
  },
  {
    "start": 231.2,
    "end": 232.48,
    "text": "有一點有一點"
  },
  {
    "start": 232.48,
    "end": 233.68,
    "text": "對"
  },
  {
    "start": 233.68,
    "end": 235.68,
    "text": "對不對 國小時代"
  },
  {
    "start": 235.68,
    "end": 237.18,
    "text": "米里卡書中心"
  },
  {
    "start": 237.18,
    "end": 238.68,
    "text": "在那邊買手苦讀"
  },
  {
    "start": 238.68,
    "end": 239.68,
    "text": "大概就像這樣子"
  },
  {
    "start": 239.68,
    "end": 240.68,
    "text": "是啊"
  },
  {
    "start": 240.68,
    "end": 243.68,
    "text": "因為跟以前我們在研究室大學的時候"
  },
  {
    "start": 243.68,
    "end": 244.68,
    "text": "也大概就是長這樣"
  },
  {
    "start": 244.68,
    "end": 246.68,
    "text": "所以我比較習慣這樣"
  },
  {
    "start": 246.68,
    "end": 250.68,
    "text": "因為我們在大學買手在念書苦讀的時候"
  },
  {
    "start": 250.68,
    "end": 251.68,
    "text": "對"
  },
  {
    "start": 251.68,
    "end": 252.68,
    "text": "氛圍就是像這樣"
  },
  {
    "start": 252.68,
    "end": 254.68,
    "text": "再重新把它營造出來"
  },
  {
    "start": 254.68,
    "end": 256.68,
