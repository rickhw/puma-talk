  {
    "start": 159.1,
    "end": 160.1,
    "text": "白沙特帶來的"
  },
  {
    "start": 160.1,
    "end": 161.1,
    "text": "很樸素啦"
  },
  {
    "start": 161.1,
    "end": 163.1,
    "text": "就是一般大概"
  },
  {
    "start": 163.1,
    "end": 165.1,
    "text": "我們立委辦公室都有"
  },
  {
    "start": 165.1,
    "end": 167.1,
    "text": "這一定要有個會議室"
  },
  {
    "start": 167.1,
    "end": 169.1,
    "text": "我們的烏克蘭"
