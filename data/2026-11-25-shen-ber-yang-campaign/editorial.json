    },
    {
      "start": 99.82,
      "end": 100.5,
      "text": "出來"
    },
    {
      "start": 100.5,
      "end": 102.25999999999999,
      "text": "3日"
    },
    {
      "start": 102.25999999999999,
      "end": 103.18,
      "text": "神寶養"
    },
    {
      "start": 103.18,
      "end": 103.9,
      "text": "謝謝大家"
    },
    {
      "start": 103.9,
      "end": 104.58,
      "text": "謝謝"
    },
    {
      "start": 104.58,
      "end": 106.53999999999999,
      "text": "謝謝"
    },
    {
      "start": 106.53999999999999,
      "end": 108.53999999999999,
      "text": "謝謝"
    },
    {
      "start": 108.53999999999999,
      "end": 109.66,
      "text": "用越南話也可以"
    },
    {
      "start": 109.66,
      "end": 111.06,
      "text": "現在換越南話"
    },
    {
      "start": 111.06,
      "end": 112.38,
      "text": "好啊"
    },
    {
      "start": 112.38,
