  {
    "start": 170.9,
    "end": 172.9,
    "text": "其實大部分就是打電話給1999"
  },
  {
    "start": 172.9,
    "end": 175.74,
    "text": "所以那個時候其實在這些額虐案"
  },
  {
    "start": 175.74,
    "end": 176.6,
    "text": "因為額虐案其實"
  },
  {
    "start": 176.6,
    "end": 178.42000000000002,
    "text": "台北市政府最近的額虐案"
  },
  {
    "start": 178.42000000000002,
    "end": 179.84,
    "text": "是真的多到爆炸"
  },
  {
    "start": 179.84,
    "end": 181.98000000000002,
    "text": "最近就是這三年"
  },
  {
    "start": 181.98000000000002,
    "end": 183.70000000000002,
    "text": "就是這三年的台北市政府"
  },
  {
    "start": 183.70000000000002,
    "end": 185.6,
    "text": "是八起重大額虐案"
  },
  {
    "start": 185.6,
    "end": 187.88,
    "text": "一百多個小孩受害"
  },
  {
    "start": 187.88,
    "end": 190.66,
    "text": "然後六百多次的不當對待"
