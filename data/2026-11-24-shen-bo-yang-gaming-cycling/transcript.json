  {
    "start": 213.62,
    "end": 214.32,
    "text": "快速回答"
  },
  {
    "start": 214.32,
    "end": 218.06,
    "text": "花生湯圓跟芝麻湯圓比較喜歡哪?"
  },
  {
    "start": 218.06,
    "end": 221.1,
    "text": "糯米玉米跟水果玉米是什麼東西?"
  },
  {
    "start": 221.1,
    "end": 221.66,
    "text": "不知道"
  },
  {
    "start": 221.66,
    "end": 222.7,
    "text": "糯米"
  },
  {
    "start": 222.7,
    "end": 225.04,
    "text": "就是白色的"
  },
  {
    "start": 225.04,
    "end": 227.5,
    "text": "然後水果玉米就是黃色的"
  },
  {
    "start": 227.5,
    "end": 229.2,
    "text": "就是淡彩色的"
  },
  {
    "start": 229.2,
    "end": 231.18,
    "text": "原來玉米有品種"
  },
  {
    "start": 231.18,
    "end": 233.46,
    "text": "水果玉米比较甜,糯米玉米就是"
  },
  {
    "start": 233.46,
    "end": 235.08,
    "text": "比较有淀粉的味道"
  },
  {
    "start": 235.08,
    "end": 237.24,
    "text": "我跟你講改天你們來厄瓜多吃玉米"
  },
  {
    "start": 237.24,
    "end": 239.12,
    "text": "厄瓜多玉米超大,大到爆炸"
  },
  {
    "start": 239.12,
    "end": 241.0,
    "text": "厄瓜多玉米超肥超大"
  },
  {
    "start": 241.0,
    "end": 243.0,
    "text": "你可不可以帶回來"
  },
  {
    "start": 243.0,
    "end": 244.36,
    "text": "太遠了"
  },
  {
    "start": 244.36,
    "end": 246.66,
    "text": "欸,無論我們去美國呢"
  },
  {
    "start": 246.66,
    "end": 248.08,
    "text": "我們還可以再飛厄瓜多"
  },
  {
    "start": 248.08,
    "end": 249.02,
    "text": "我可以帶你們去"
  },
  {
    "start": 249.02,
    "end": 250.20000000000002,
    "text": "厄瓜多真的蠻好玩的"
  },
  {
    "start": 250.20000000000002,
    "end": 251.76000000000002,
    "text": "厄瓜多路上都蜥蜴"
  },
  {
    "start": 251.76000000000002,
    "end": 253.54000000000002,
    "text": "可是,腦都那麼大"
  },
  {
    "start": 253.54000000000002,
    "end": 254.64000000000001,
    "text": "可是這會期要看到蜥蜴三十一"
  },
  {
    "start": 254.64000000000001,
    "end": 256.06,
    "text": "就跟我們路上有狗一樣"
  },
  {
    "start": 256.06,
    "end": 257.26,
    "text": "對"
  },
  {
    "start": 257.26,
    "end": 259.26,
    "text": "對"
  },
  {
    "start": 259.26,
    "end": 261.59999999999997,
    "text": "披薩加跟不加鳳梨"
  },
  {
    "start": 261.59999999999997,
    "end": 263.26,
    "text": "不能加吧"
  },
  {
    "start": 263.26,
    "end": 265.26,
    "text": "鳳梨能吃嗎"
  },
  {
    "start": 265.26,
    "end": 266.26,
    "text": "賴皮魚有"
  },
  {
    "start": 266.26,
    "end": 268.26,
    "text": "黃姐要吃鳳梨漿"
