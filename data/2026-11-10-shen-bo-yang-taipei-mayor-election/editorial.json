{
  "videoId": "GYeE73a9diU",
  "version": "traditional-editorial-v2",
  "sourceSha256": "d3f56a38f5f512c380d6fec1c3bb2dcc1da511a824c7282bdd52db2bca78cbd8",
  "keywords": [
    "真相對話錄",
    "臺北市長選戰",
    "徵召",
    "民調",
    "基本盤",
    "基層互動",
    "車掃",
    "參選"
  ],
  "transcript": [
    {
      "start": 0.0,
      "end": 2.8000000000000003,
      "text": "歡迎收看真相對話錄"
    },
    {
      "start": 2.8000000000000003,
      "end": 3.4,
      "text": "我是洪培翔"
    },
    {
      "start": 3.4,
      "end": 5.62,
      "text": "我們來看這是今年10月4號"
    },
    {
      "start": 5.62,
      "end": 7.44,
      "text": "民進黨臺北市長候選人"
    },
    {
      "start": 7.44,
      "end": 9.82,
      "text": "沈伯洋的競選總部成立了場面"
    },
    {
      "start": 9.82,
      "end": 11.56,
      "text": "競總說現場滿滿的人潮"
    },
    {
      "start": 11.56,
      "end": 12.56,
      "text": "超過了12萬"
    },
    {
      "start": 12.56,
      "end": 14.08,
      "text": "陳培瑜告訴我們"
    },
    {
      "start": 14.08,
      "end": 16.64,
      "text": "當時站在臺上的沈伯洋跟他說"
    },
    {
      "start": 16.64,
      "end": 18.78,
      "text": "他已經有點眼泛淚光了"
    },
    {
      "start": 18.78,
      "end": 19.94,
      "text": "他跟陳培瑜說"
    },
    {
      "start": 19.94,
      "end": 21.78,
      "text": "希望媽媽也能夠看到"
    },
    {
      "start": 21.78,
      "end": 23.72,
      "text": "因為坦白說就在半年前"
    },
    {
      "start": 23.72,
      "end": 24.98,
      "text": "有誰能夠想像"
    },
    {
      "start": 24.98,
      "end": 26.54,
      "text": "這樣的場面會發生呢"
    },
    {
      "start": 26.54,
      "end": 30.919999999999998,
      "text": "沈伯洋這樣一個只當過不分區立委兩年時間"
    },
    {
      "start": 30.919999999999998,
      "end": 33.32,
      "text": "而且他完全沒有任何選舉經驗的人"
    },
    {
      "start": 33.32,
      "end": 37.08,
      "text": "他第一次參選就要扛這麼重要的首都市長選舉"
    },
    {
      "start": 37.08,
      "end": 40.62,
      "text": "而沈伯洋竟然能夠在短短的六個月的時間之內"
    },
    {
      "start": 40.62,
      "end": 42.96,
      "text": "他捲起了一股聲勢驚人的洋流"
    },
    {
      "start": 42.96,
      "end": 45.519999999999996,
      "text": "沈伯洋他究竟怎麼跌破大家的眼鏡"
    },
    {
      "start": 45.519999999999996,
      "end": 47.120000000000005,
      "text": "他究竟怎麼辦到的呢"
    },
    {
      "start": 47.120000000000005,
      "end": 50.04,
      "text": "在今天的節目當中我們專訪他的同志"
    },
    {
      "start": 50.04,
      "end": 51.82,
      "text": "包括是台北市議員洪健益"
    },
    {
      "start": 51.82,
      "end": 54.08,
      "text": "顏若芳以及立委陳培瑜"
    },
    {
      "start": 54.08,
      "end": 55.68,
      "text": "我們要透過他們的觀察"
    },
    {
      "start": 55.68,
      "end": 59.019999999999996,
      "text": "一塊來揭開這股洋流崛起的關鍵內幕"
    },
    {
      "start": 59.019999999999996,
      "end": 60.46,
      "text": "好,首先我們先來看看"
    },
    {
      "start": 60.46,
      "end": 63.04,
      "text": "這一連串的民調數字"
    },
    {
      "start": 63.04,
      "end": 64.64,
      "text": "透露什麼樣的訊號呢"
    },
    {
      "start": 64.64,
      "end": 66.74,
      "text": "先來看看今年的5月13號"
    },
    {
      "start": 66.74,
      "end": 68.64,
      "text": "民進黨徵召提名了沈伯洋"
    },
    {
      "start": 68.64,
      "end": 69.92,
      "text": "參選臺北市長"
    },
    {
      "start": 69.92,
      "end": 73.36,
      "text": "而當時TVBS做的這份民調數字顯示"
    },
    {
      "start": 73.36,
      "end": 74.96,
      "text": "蔣萬安58%"
    },
    {
      "start": 74.96,
      "end": 77.25999999999999,
      "text": "沈伯洋只有30%"
    },
    {
      "start": 77.25999999999999,
      "end": 80.52,
      "text": "蔣萬安遙遙領先了28個百分點"
    },
    {
      "start": 80.52,
      "end": 82.6,
      "text": "很多人包括民進黨自己人"
    },
    {
      "start": 82.6,
      "end": 85.89999999999999,
      "text": "都坦承這恐怕是一場沒有懸念的選戰"
    },
    {
      "start": 85.89999999999999,
      "end": 87.61999999999999,
      "text": "因為不管你派誰出來"
    },
    {
      "start": 87.61999999999999,
      "end": 89.36,
      "text": "恐怕你都贏不了蔣萬安"
    },
    {
      "start": 89.36,
      "end": 91.46,
      "text": "不過民進黨的黨主席"
    },
    {
      "start": 91.46,
      "end": 94.02,
      "text": "賴清德他可不是這麼想的"
    },
    {
      "start": 94.02,
      "end": 94.97999999999999,
      "text": "他獨排眾議"
    },
    {
      "start": 94.97999999999999,
      "end": 97.33999999999999,
      "text": "他堅持要提名沈伯洋"
    },
    {
      "start": 97.33999999999999,
      "end": 99.82,
      "text": "而他從來不是只是為了"
    },
    {
      "start": 99.82,
      "end": 101.84,
      "text": "要把蔣萬安牽制在臺北市"
    },
    {
      "start": 101.84,
      "end": 103.72,
      "text": "賴清德就是相信"
    },
    {
      "start": 103.72,
      "end": 105.36,
      "text": "沈伯洋他會贏的"
    },
    {
      "start": 105.36,
      "end": 106.24,
      "text": "為什麼呢"
    },
    {
      "start": 106.24,
      "end": 108.58,
      "text": "因為他看到了2025年這場"
    },
    {
      "start": 108.58,
      "end": 110.6,
      "text": "遠在紐約的市長選舉"
    },
    {
      "start": 110.6,
      "end": 112.64,
      "text": "給了賴清德什麼樣的靈感呢"
    },
    {
      "start": 112.64,
      "end": 114.33999999999999,
      "text": "在今天我們會告訴您"
    },
    {
      "start": 114.33999999999999,
      "end": 116.14,
      "text": "這個內幕的故事"
    },
    {
      "start": 116.14,
      "end": 118.33999999999999,
      "text": "那麼至於沈伯洋他本人呢"
    },
    {
      "start": 118.33999999999999,
      "end": 120.08,
      "text": "當他在前面四個月"
    },
    {
      "start": 120.08,
      "end": 121.86,
      "text": "不管他怎麼到處去掃夜市"
    },
    {
      "start": 121.86,
      "end": 122.91999999999999,
      "text": "但是你看到了"
    },
    {
      "start": 122.91999999999999,
      "end": 126.22,
      "text": "他的民調數字就是一直起不來"
    },
    {
      "start": 126.22,
      "end": 128.22,
      "text": "他有沒有懷疑過自己呢"
    },
    {
      "start": 128.22,
      "end": 130.5,
      "text": "臺北市議員顏若芳說呢"
    },
    {
      "start": 130.5,
      "end": 133.32,
      "text": "其實早在沈伯洋還沒有被提名之前"
    },
    {
      "start": 133.32,
      "end": 136.16,
      "text": "他曾經傳了一封簡訊給顏若芳"
    },
    {
      "start": 136.16,
      "end": 138.57999999999998,
      "text": "沈伯洋問了一個有點奇怪的問題"
    },
    {
      "start": 138.58,
      "end": 140.94000000000003,
      "text": "難道當時沈伯洋已經在構思"
    },
    {
      "start": 140.94000000000003,
      "end": 143.42000000000002,
      "text": "他要怎麼樣打贏這場選戰了嗎"
    },
    {
      "start": 143.42000000000002,
      "end": 144.48000000000002,
      "text": "非常顯然"
    },
    {
      "start": 144.48000000000002,
      "end": 145.92000000000002,
      "text": "沈伯洋有他的戰略"
    },
    {
      "start": 145.92000000000002,
      "end": 146.72000000000003,
      "text": "有他的節奏"
    },
    {
      "start": 146.72000000000003,
      "end": 150.70000000000002,
      "text": "從5月落後了28個百分點"
    },
    {
      "start": 150.70000000000002,
      "end": 152.20000000000002,
      "text": "那麼一直到10月"
    },
    {
      "start": 152.20000000000002,
      "end": 154.08,
      "text": "我們來看看同樣一個民調機構"
    },
    {
      "start": 154.08,
      "end": 157.44,
      "text": "也就是TVBS所做出的民調顯示"
    },
    {
      "start": 157.44,
      "end": 160.68,
      "text": "沈伯洋已經追到了41比49"
    },
    {
      "start": 160.68,
      "end": 163.16000000000003,
      "text": "他只有落後8個百分點了"
    },
    {
      "start": 163.16000000000003,
      "end": 165.14000000000001,
      "text": "甚至在10月31號這一天"
    },
    {
      "start": 165.14000000000001,
      "end": 167.38000000000002,
      "text": "第一場的電視辯論會之後"
    },
    {
      "start": 167.38,
      "end": 169.94,
      "text": "TVBS馬上做的民調數字顯示"
    },
    {
      "start": 169.94,
      "end": 172.06,
      "text": "蔣萬安46%"
    },
    {
      "start": 172.06,
      "end": 174.6,
      "text": "那麼沈伯洋42%"
    },
    {
      "start": 174.6,
      "end": 177.68,
      "text": "雙方只剩下了4個百分點的差距了"
    },
    {
      "start": 177.68,
      "end": 180.14,
      "text": "在短短的你看到6個月之內"
    },
    {
      "start": 180.14,
      "end": 182.74,
      "text": "沈伯洋他究竟做了哪些的事情"
    },
    {
      "start": 182.74,
      "end": 185.32,
      "text": "能夠拉近24個百分點呢"
    },
    {
      "start": 185.32,
      "end": 188.01999999999998,
      "text": "甚至根據信民協會的民調數字"
    },
    {
      "start": 188.01999999999998,
      "end": 190.18,
      "text": "我們來看到在10月份的時候"
    },
    {
      "start": 190.18,
      "end": 193.01999999999998,
      "text": "沈伯洋不但完成了黃金交叉"
    },
    {
      "start": 193.01999999999998,
      "end": 194.48,
      "text": "而且他的領先幅度"
    },
    {
      "start": 194.48,
      "end": 197.64,
      "text": "竟然達到了17個百分點"
    },
    {
      "start": 197.64,
      "end": 200.42,
      "text": "有人說不管最後的選舉結果如何"
    },
    {
      "start": 200.42,
      "end": 202.67999999999998,
      "text": "沈伯洋他都已經贏了"
    },
    {
      "start": 202.67999999999998,
      "end": 205.82,
      "text": "他已經成為的是民進黨未來一顆"
    },
    {
      "start": 205.82,
      "end": 208.39999999999998,
      "text": "極其閃耀的政治明星了"
    },
    {
      "start": 208.39999999999998,
      "end": 210.98,
      "text": "我們的市長"
    },
    {
      "start": 210.98,
      "end": 212.33999999999997,
      "text": "沈伯洋"
    },
    {
      "start": 212.33999999999997,
      "end": 214.16,
      "text": "我們的市長"
    },
    {
      "start": 214.16,
      "end": 215.72,
      "text": "沈伯洋"
    },
    {
      "start": 215.72,
      "end": 217.5,
      "text": "我們的市長"
    },
    {
      "start": 217.5,
      "end": 218.89999999999998,
      "text": "沈伯洋"
    },
    {
      "start": 218.89999999999998,
      "end": 219.89999999999998,
      "text": "沈伯洋"
    },
    {
      "start": 219.89999999999998,
      "end": 220.73999999999998,
      "text": "宗宗"
    },
    {
      "start": 220.73999999999998,
      "end": 221.54,
      "text": "沈伯洋"
    },
    {
      "start": 221.54,
      "end": 222.22,
      "text": "宗宗"
    },
    {
      "start": 222.22,
      "end": 223.42,
      "text": "10月18號"
    },
    {
      "start": 223.42,
      "end": 226.76,
      "text": "距離臺北市場選舉的投票日倒數41天"
    },
    {
      "start": 226.76,
      "end": 228.83999999999997,
      "text": "這是一個禮拜天的傍晚"
    },
    {
      "start": 228.83999999999997,
      "end": 230.67999999999998,
      "text": "沈伯洋的第二場的車掃"
    },
    {
      "start": 230.67999999999998,
      "end": 232.17999999999998,
      "text": "意義特別不同"
    },
    {
      "start": 232.17999999999998,
      "end": 244.17999999999998,
      "text": "沈伯洋回到了老家五分埔"
    },
    {
      "start": 244.17999999999998,
      "end": 245.57999999999998,
      "text": "他誠懇地請託"
    },
    {
      "start": 245.57999999999998,
      "end": 247.2,
      "text": "忘情地振臂高呼"
    },
    {
      "start": 247.2,
      "end": 249.27999999999997,
      "text": "有網友看到他的表情說"
    },
    {
      "start": 249.27999999999997,
      "end": 252.27999999999997,
      "text": "這一晚看得出來沈伯洋真的很開心"
    },
    {
      "start": 252.28,
      "end": 254.88,
      "text": "因為沿途幫他加油打氣的人群裡"
    },
    {
      "start": 254.88,
      "end": 257.58,
      "text": "還有從小看著他長大的親朋好友"
    },
    {
      "start": 257.58,
      "end": 258.42,
      "text": "左鄰右舍"
    },
    {
      "start": 258.42,
      "end": 260.06,
      "text": "但是沒有想到"
    },
    {
      "start": 260.06,
      "end": 261.86,
      "text": "就在經過沈伯洋老家的時候"
    },
    {
      "start": 261.86,
      "end": 263.28,
      "text": "整個車隊的速度"
    },
    {
      "start": 263.28,
      "end": 265.42,
      "text": "竟然忘了慢了下來"
    },
    {
      "start": 265.42,
      "end": 278.2,
      "text": "沈伯洋再怎麼樣"
    },
    {
      "start": 278.2,
      "end": 279.16,
      "text": "扯嚨喊哈囉"
    },
    {
      "start": 279.16,
      "end": 280.74,
      "text": "但車隊還是沒有理他"
    },
    {
      "start": 280.74,
      "end": 281.68,
      "text": "繼續地往前走"
    },
    {
      "start": 281.68,
      "end": 283.2,
      "text": "這個意外的插曲"
    },
    {
      "start": 283.2,
      "end": 285.72,
      "text": "讓觀看直播的網友們也傻眼了"
    },
    {
      "start": 285.72,
      "end": 287.82,
      "text": "就這樣子車隊順順地經過了"
    },
    {
      "start": 287.82,
      "end": 288.72,
      "text": "沈伯洋的老家"
    },
    {
      "start": 288.72,
      "end": 291.92,
      "text": "沒能跟阿嬤阿姑好好打個招呼"
    },
    {
      "start": 291.92,
      "end": 293.06,
      "text": "很滿足啊"
    },
    {
      "start": 293.06,
      "end": 293.8,
      "text": "阿嬤在"
    },
    {
      "start": 293.8,
      "end": 294.84000000000003,
      "text": "很久沒看到他"
    },
    {
      "start": 294.84000000000003,
      "end": 296.26,
      "text": "今天終於看到他了"
    },
    {
      "start": 296.26,
      "end": 298.26,
      "text": "有有常常啊有啊"
    },
    {
      "start": 298.26,
      "end": 299.02,
      "text": "有啊"
    },
    {
      "start": 299.02,
      "end": 300.54,
      "text": "現在因為他很忙"
    },
    {
      "start": 300.54,
      "end": 302.66,
      "text": "我希望他看到我們啊"
    },
    {
      "start": 302.66,
      "end": 303.66,
      "text": "可是都沒看到"
    },
    {
      "start": 303.66,
      "end": 304.62,
      "text": "沒關係"
    },
    {
      "start": 304.62,
      "end": 305.54,
      "text": "開心"
    },
    {
      "start": 305.54,
      "end": 306.46000000000004,
      "text": "開心"
    },
    {
      "start": 306.46000000000004,
      "end": 308.1,
      "text": "說到了沈伯洋這個孩子"
    },
    {
      "start": 308.1,
      "end": 309.82,
      "text": "長輩眼裡滿是驕傲"
    },
    {
      "start": 309.82,
      "end": 311.82,
      "text": "也充滿了心疼和不捨"
    },
    {
      "start": 311.82,
      "end": 314.42,
      "text": "看著沈伯洋從不被看好"
    },
    {
      "start": 314.42,
      "end": 315.65999999999997,
      "text": "一路走到這裡"
    },
    {
      "start": 315.65999999999997,
      "end": 317.06,
      "text": "真的很不容易"
    },
    {
      "start": 317.06,
      "end": 325.48,
      "text": "有網友說這是動漫場景吧"
    },
    {
      "start": 325.48,
      "end": 327.58,
      "text": "這個空拍再配上這首音樂"
    },
    {
      "start": 327.58,
      "end": 329.98,
      "text": "真的要把人逼哭不可嗎"
    },
    {
      "start": 329.98,
      "end": 334.15999999999997,
      "text": "你的市長"
    },
    {
      "start": 334.15999999999997,
      "end": 335.7,
      "text": "沈伯洋"
    },
    {
      "start": 335.7,
      "end": 337.42,
      "text": "北北大洋流"
    },
    {
      "start": 337.42,
      "end": 341.76,
      "text": "你的市長沈伯洋正在大進場"
    },
    {
      "start": 341.76,
      "end": 344.08000000000004,
      "text": "這股洋流究竟怎麼崛起了呢"
    },
    {
      "start": 344.08000000000004,
      "end": 345.42,
      "text": "如果仔細回想"
    },
    {
      "start": 345.42,
      "end": 346.78000000000003,
      "text": "不過就在半年前"
    },
    {
      "start": 346.78000000000003,
      "end": 348.78000000000003,
      "text": "民進黨上上下下"
    },
    {
      "start": 348.78000000000003,
      "end": 350.90000000000003,
      "text": "還在為了派誰來選臺北市長"
    },
    {
      "start": 350.90000000000003,
      "end": 352.14000000000004,
      "text": "傷透了腦筋"
    },
    {
      "start": 352.14000000000004,
      "end": 355.38,
      "text": "其實應該那時候名字非常的多"
    },
    {
      "start": 355.38,
      "end": 357.78000000000003,
      "text": "包含有我們選區的世堅委員"
    },
    {
      "start": 357.78000000000003,
      "end": 359.48,
      "text": "包含思瑤姊也在裡面"
    },
    {
      "start": 359.48,
      "end": 361.78000000000003,
      "text": "我們的行政院副院長"
    },
    {
      "start": 361.78000000000003,
      "end": 363.0,
      "text": "鄭麗君也在裡面"
    },
    {
      "start": 363.0,
      "end": 365.42,
      "text": "甚至連徐國勇秘書長"
    },
    {
      "start": 365.42,
      "end": 367.08000000000004,
      "text": "甚至連卓榮泰院長"
    },
    {
      "start": 367.08,
      "end": 369.34,
      "text": "各式各樣每個禮拜都換一個名字"
    },
    {
      "start": 369.34,
      "end": 371.47999999999996,
      "text": "每個禮拜都有新名字"
    },
    {
      "start": 371.47999999999996,
      "end": 374.15999999999997,
      "text": "甚至連臺北101董事長賈永傑"
    },
    {
      "start": 374.15999999999997,
      "end": 375.41999999999996,
      "text": "他都被點到名了"
    },
    {
      "start": 375.41999999999996,
      "end": 378.62,
      "text": "考量說賈永傑本身比較有"
    },
    {
      "start": 378.62,
      "end": 379.71999999999997,
      "text": "他也是外省二代"
    },
    {
      "start": 379.71999999999997,
      "end": 383.76,
      "text": "可能破圈的那個選法"
    },
    {
      "start": 383.76,
      "end": 387.4,
      "text": "破圈是民進黨在臺北市想贏的關鍵字"
    },
    {
      "start": 387.4,
      "end": 389.03999999999996,
      "text": "因為傳統印象中"
    },
    {
      "start": 389.03999999999996,
      "end": 390.52,
      "text": "臺北市藍大於綠"
    },
    {
      "start": 390.52,
      "end": 392.28,
      "text": "非破不能贏"
    },
    {
      "start": 392.28,
      "end": 397.0,
      "text": "尤其是你越傳統的政治人物"
    },
    {
      "start": 397.0,
      "end": 401.28,
      "text": "在臺北市可能很難吸引中間選民"
    },
    {
      "start": 401.28,
      "end": 405.96,
      "text": "到後面有一天突然出現了沈伯洋的名字"
    },
    {
      "start": 405.96,
      "end": 408.02,
      "text": "聽到了沈伯洋這個名字"
    },
    {
      "start": 408.02,
      "end": 410.14,
      "text": "要靠他爭取中間選民嗎"
    },
    {
      "start": 410.14,
      "end": 413.28,
      "text": "坦白說連自己人心裡都沒把握"
    },
    {
      "start": 413.28,
      "end": 415.54,
      "text": "母雞不夠強小雞很難選"
    },
    {
      "start": 415.54,
      "end": 418.46,
      "text": "每個人認真拚自己的"
    },
    {
      "start": 418.46,
      "end": 420.26,
      "text": "我現任的議員搞不好"
    },
    {
      "start": 420.26,
      "end": 422.28,
      "text": "在我當區的知名度比沈伯洋高"
    },
    {
      "start": 422.28,
      "end": 426.28,
      "text": "所以那時候大家對他還是不樂觀"
    },
    {
      "start": 426.28,
      "end": 427.26,
      "text": "雖然不唱衰"
    },
    {
      "start": 427.26,
      "end": 428.14,
      "text": "但是也不樂觀"
    },
    {
      "start": 428.14,
      "end": 429.14,
      "text": "不唱衰"
    },
    {
      "start": 429.14,
      "end": 430.71999999999997,
      "text": "但真的也樂觀不起來"
    },
    {
      "start": 430.71999999999997,
      "end": 432.32,
      "text": "因為對某些選民來說"
    },
    {
      "start": 432.32,
      "end": 434.15999999999997,
      "text": "聽到沈伯洋這個名字"
    },
    {
      "start": 434.15999999999997,
      "end": 436.09999999999997,
      "text": "連結的是這些形象"
    },
    {
      "start": 436.09999999999997,
      "end": 437.41999999999996,
      "text": "國民黨跟民眾黨"
    },
    {
      "start": 437.41999999999996,
      "end": 439.5,
      "text": "之前把它設定的一個人設叫做"
    },
    {
      "start": 439.5,
      "end": 441.67999999999995,
      "text": "反共啦 臺獨啦"
    },
    {
      "start": 441.67999999999995,
      "end": 444.05999999999995,
      "text": "然後可能什麼黑熊學院啊"
    },
    {
      "start": 444.05999999999995,
      "end": 446.46,
      "text": "然後它是會製造成恐慌的那種"
    },
    {
      "start": 446.46,
      "end": 449.23999999999995,
      "text": "然後有的當然也會擔心"
    },
    {
      "start": 449.23999999999995,
      "end": 453.2,
      "text": "就是伯洋的仇恨值太高"
    },
    {
      "start": 453.2,
      "end": 455.2,
      "text": "那尤其在臺北市"
    },
    {
      "start": 455.2,
      "end": 456.9,
      "text": "仇恨值太高的"
    },
    {
      "start": 456.9,
      "end": 459.47999999999996,
      "text": "可能很難選"
    },
    {
      "start": 459.47999999999996,
      "end": 462.0,
      "text": "很難打動中間選民"
    },
    {
      "start": 462.0,
      "end": 463.78,
      "text": "你們這些名嘴都在說"
    },
    {
      "start": 463.78,
      "end": 464.47999999999996,
      "text": "他不行"
    },
    {
      "start": 464.47999999999996,
      "end": 466.52,
      "text": "但是我覺得最後面會是他"
    },
    {
      "start": 466.52,
      "end": 467.98,
      "text": "我要先講一句網路梗"
    },
    {
      "start": 467.98,
      "end": 469.7,
      "text": "哥先發現的喔"
    },
    {
      "start": 469.7,
      "end": 471.14,
      "text": "不是姐"
    },
    {
      "start": 471.14,
      "end": 472.58,
      "text": "是哥先發現的喔"
    },
    {
      "start": 472.58,
      "end": 474.48,
      "text": "那一次我請這些媒體大哥"
    },
    {
      "start": 474.48,
      "end": 475.52,
      "text": "因為我上節目都"
    },
    {
      "start": 475.52,
      "end": 477.56,
      "text": "受他們指導照顧"
    },
    {
      "start": 477.56,
      "end": 479.21999999999997,
      "text": "那我就請他們吃飯"
    },
    {
      "start": 479.21999999999997,
      "end": 481.0,
      "text": "我說我可不可以邀一個人"
    },
    {
      "start": 481.0,
      "end": 481.94,
      "text": "沈伯洋"
    },
    {
      "start": 481.94,
      "end": 482.8,
      "text": "他們說好"
    },
    {
      "start": 482.8,
      "end": 484.58,
      "text": "那沈伯洋來了"
    },
    {
      "start": 484.58,
      "end": 486.18,
      "text": "松山慈惠堂那一場"
    },
    {
      "start": 486.18,
      "end": 487.91999999999996,
      "text": "他根本沒有行程"
    },
    {
      "start": 487.91999999999996,
      "end": 489.84,
      "text": "是我跟他講"
    },
    {
      "start": 489.84,
      "end": 492.18,
      "text": "我說那一天你要來"
    },
    {
      "start": 492.18,
      "end": 495.41999999999996,
      "text": "開始有人帶著沈伯洋跑行程認識人了"
    },
    {
      "start": 495.41999999999996,
      "end": 496.41999999999996,
      "text": "不過事實上"
    },
    {
      "start": 496.41999999999996,
      "end": 498.12,
      "text": "他自己也已經先做好了功課"
    },
    {
      "start": 498.12,
      "end": 500.4,
      "text": "當大家都還在懷疑他的時候"
    },
    {
      "start": 500.4,
      "end": 503.29999999999995,
      "text": "沈伯洋傳了一封訊息給顏若芳"
    },
    {
      "start": 503.29999999999995,
      "end": 504.41999999999996,
      "text": "其實我覺得"
    },
    {
      "start": 504.41999999999996,
      "end": 506.97999999999996,
      "text": "偷偷小小抱一個小小的料"
    },
    {
      "start": 506.97999999999996,
      "end": 509.32,
      "text": "其實那時候在伯洋的名字"
    },
    {
      "start": 509.32,
      "end": 510.44,
      "text": "還沒有出來的時候"
    },
    {
      "start": 510.44,
      "end": 512.9399999999999,
      "text": "他突然傳了一個訊息給我說"
    },
    {
      "start": 512.94,
      "end": 516.2800000000001,
      "text": "若芳我想問你"
    },
    {
      "start": 516.2800000000001,
      "end": 519.6600000000001,
      "text": "就是整個大罷免之後一直到現在"
    },
    {
      "start": 519.6600000000001,
      "end": 522.34,
      "text": "你覺得民進黨的基本盤"
    },
    {
      "start": 522.34,
      "end": 524.98,
      "text": "在臺北市的狀況是怎麼樣"
    },
    {
      "start": 524.98,
      "end": 526.9200000000001,
      "text": "沈伯洋到底想幹嘛呢"
    },
    {
      "start": 526.9200000000001,
      "end": 529.44,
      "text": "他沒有先問大家知不支持自己"
    },
    {
      "start": 529.44,
      "end": 530.48,
      "text": "他問的是"
    },
    {
      "start": 530.48,
      "end": 531.86,
      "text": "在大罷免之後"
    },
    {
      "start": 531.86,
      "end": 534.5200000000001,
      "text": "臺北市還有多少民進黨的基本盤呢"
    },
    {
      "start": 534.5200000000001,
      "end": 537.5400000000001,
      "text": "如果真的要他來打這場艱困的選戰"
    },
    {
      "start": 537.5400000000001,
      "end": 539.62,
      "text": "他要怎麼打才會贏呢"
    },
    {
      "start": 539.62,
      "end": 542.42,
      "text": "2026年4月25號"
    },
    {
      "start": 542.42,
      "end": 543.94,
      "text": "距離臺北市場選舉投票日"
    },
    {
      "start": 543.94,
      "end": 545.66,
      "text": "倒數217天"
    },
    {
      "start": 545.66,
      "end": 548.5,
      "text": "儘管沈伯洋還沒有獲得正式提名"
    },
    {
      "start": 548.5,
      "end": 550.32,
      "text": "不過他第一次和現任市長"
    },
    {
      "start": 550.32,
      "end": 551.66,
      "text": "蔣萬安同框的場合"
    },
    {
      "start": 551.66,
      "end": 553.88,
      "text": "已經是媒體關注的焦點了"
    },
    {
      "start": 553.88,
      "end": 557.44,
      "text": "這天沈伯洋和蔣萬安"
    },
    {
      "start": 557.44,
      "end": 558.66,
      "text": "其實沒有太多的互動"
    },
    {
      "start": 558.66,
      "end": 560.58,
      "text": "有記者問到蔣萬安這一題"
    },
    {
      "start": 560.58,
      "end": 562.86,
      "text": "他的反應耐人尋味"
    },
    {
      "start": 562.86,
      "end": 564.6,
      "text": "我第一次跟蔣萬安同臺"
    },
    {
      "start": 564.6,
      "end": 565.26,
      "text": "有沒有緊張"
    },
    {
      "start": 565.26,
      "end": 568.8,
      "text": "［此段辨識不清，請對照原片］"
    },
    {
      "start": 568.8,
      "end": 571.0999999999999,
      "text": "已經來好幾次了"
    },
    {
      "start": 571.0999999999999,
      "end": 571.8,
      "text": "對啊"
    },
    {
      "start": 571.8,
      "end": 573.5,
      "text": "做好跟沈伯洋來場"
    },
    {
      "start": 573.5,
      "end": 574.8,
      "text": "君子之爭的準備嗎"
    },
    {
      "start": 575.8,
      "end": 577.8,
      "text": "我想離選舉還有一段時間"
    },
    {
      "start": 577.8,
      "end": 578.8,
      "text": "就專注市政"
    },
    {
      "start": 578.8,
      "end": 580.3,
      "text": "對他的新造型……"
    },
    {
      "start": 580.3,
      "end": 581.3,
      "text": "你有聽到嗎"
    },
    {
      "start": 581.3,
      "end": 582.3,
      "text": "欸你的同事"
    },
    {
      "start": 582.3,
      "end": 583.8,
      "text": "我剛剛其實沒聽到"
    },
    {
      "start": 583.8,
      "end": 585.8,
      "text": "他們那種很"
    },
    {
      "start": 585.8,
      "end": 586.8,
      "text": "很瞧不起"
    },
    {
      "start": 586.8,
      "end": 588.8,
      "text": "或者是很輕蔑的那種態度"
    },
    {
      "start": 588.8,
      "end": 591.3,
      "text": "就是好像不把沈伯洋放在眼裡"
    },
    {
      "start": 591.3,
      "end": 593.3,
      "text": "他不屑談沈伯洋"
    },
    {
      "start": 593.3,
      "end": 595.3,
      "text": "蔣萬安本來要打冷戰"
    },
    {
      "start": 595.3,
      "end": 596.8,
      "text": "你是什麼咖"
    },
    {
      "start": 596.8,
      "end": 597.8,
      "text": "我要跟你辯論"
    },
    {
      "start": 597.8,
      "end": 601.3,
      "text": "他之前的選法是內外皆冷"
    },
    {
      "start": 601.3,
      "end": 603.8,
      "text": "我懶得理你 你多厲害喔"
    },
    {
      "start": 603.8,
      "end": 606.8,
      "text": "我躺到選舉那天我就當選了"
    },
    {
      "start": 606.8,
      "end": 608.8,
      "text": "樂見啊"
    },
    {
      "start": 608.8,
      "end": 610.3,
      "text": "有些人就會覺得"
    },
    {
      "start": 610.3,
      "end": 612.8,
      "text": "沈伯洋長得像木村拓哉"
    },
    {
      "start": 612.8,
      "end": 613.8,
      "text": "小泉進次郎"
    },
    {
      "start": 613.8,
      "end": 616.8,
      "text": "然後也覺得他有張孝全的性魅力"
    },
    {
      "start": 616.8,
      "end": 619.8,
      "text": "這些說法我們都予以尊重"
    },
    {
      "start": 619.8,
      "end": 621.8,
      "text": "但雖然難予同意"
    },
    {
      "start": 621.8,
      "end": 623.8,
      "text": "民進黨真的要派沈伯洋嗎"
    },
    {
      "start": 623.8,
      "end": 625.8,
      "text": "確定嗎"
    },
    {
      "start": 627.8,
      "end": 629.8,
      "text": "太精彩了"
    },
    {
      "start": 629.8,
      "end": 631.04,
      "text": "沈伯洋事後回想"
    },
    {
      "start": 631.04,
      "end": 632.5799999999999,
      "text": "當時笑他的人太多了"
    },
    {
      "start": 632.5799999999999,
      "end": 634.14,
      "text": "所以他並沒有特別在意"
    },
    {
      "start": 634.14,
      "end": 635.5999999999999,
      "text": "反倒是提醒自己"
    },
    {
      "start": 635.5999999999999,
      "end": 638.18,
      "text": "專注在真正該做的事情上"
    },
    {
      "start": 638.18,
      "end": 641.0,
      "text": "如果忙著去在乎他們講什麼"
    },
    {
      "start": 641.0,
      "end": 643.1999999999999,
      "text": "我們真的就會少掉工作的時間"
    },
    {
      "start": 643.1999999999999,
      "end": 644.88,
      "text": "伯洋也是這樣想的"
    },
    {
      "start": 644.88,
      "end": 645.8599999999999,
      "text": "就讓他們笑吧"
    },
    {
      "start": 645.8599999999999,
      "end": 646.8,
      "text": "就跟上次一樣"
    },
    {
      "start": 646.8,
      "end": 648.5,
      "text": "我先幾個禮拜有把我頭髮修短"
    },
    {
      "start": 648.5,
      "end": 650.4799999999999,
      "text": "結果沒有想到我頭髮長那麼長"
    },
    {
      "start": 650.4799999999999,
      "end": 653.0999999999999,
      "text": "所以又趕快再把他修短了一次"
    },
    {
      "start": 653.0999999999999,
      "end": 654.88,
      "text": "中間的時候有稍微小聊了一下"
    },
    {
      "start": 654.88,
      "end": 657.3599999999999,
      "text": "想知道就是行進的過程"
    },
    {
      "start": 657.36,
      "end": 659.5,
      "text": "他是不是要往前走啊等等之類的"
    },
    {
      "start": 659.5,
      "end": 662.9,
      "text": "你先從他的第一次在保安宮"
    },
    {
      "start": 662.9,
      "end": 664.26,
      "text": "面對群眾的時候"
    },
    {
      "start": 664.26,
      "end": 667.5,
      "text": "你會覺得有點他好像不知所措"
    },
    {
      "start": 667.5,
      "end": 669.7,
      "text": "就是我到底要握手不握手"
    },
    {
      "start": 669.7,
      "end": 671.2,
      "text": "要握手不握手"
    },
    {
      "start": 671.2,
      "end": 673.5,
      "text": "就很生澀啊"
    },
    {
      "start": 673.5,
      "end": 675.42,
      "text": "在慈惠堂大庭上面"
    },
    {
      "start": 675.42,
      "end": 676.42,
      "text": "還是我跟他講"
    },
    {
      "start": 676.42,
      "end": 678.54,
      "text": "你要站這裡你要站那裡"
    },
    {
      "start": 678.54,
      "end": 680.08,
      "text": "都我跟他講"
    },
    {
      "start": 680.08,
      "end": 680.82,
      "text": "副總統來了"
    },
    {
      "start": 680.82,
      "end": 681.52,
      "text": "這個人是誰"
    },
    {
      "start": 681.52,
      "end": 682.22,
      "text": "這個人是誰"
    },
    {
      "start": 682.22,
      "end": 683.9200000000001,
      "text": "你要去握手"
    },
    {
      "start": 683.9200000000001,
      "end": 684.4200000000001,
      "text": "我還跟他講"
    },
    {
      "start": 684.4200000000001,
      "end": 686.46,
      "text": "這是慈惠堂的委員"
    },
    {
      "start": 686.46,
      "end": 687.6600000000001,
      "text": "這個誰啊 你要去握手"
    },
    {
      "start": 687.6600000000001,
      "end": 689.76,
      "text": "不是生澀 是完全不懂"
    },
    {
      "start": 689.76,
      "end": 691.9000000000001,
      "text": "一定是跟著他 因為他不懂"
    },
    {
      "start": 691.9000000000001,
      "end": 693.5,
      "text": "他那時候對這個方面"
    },
    {
      "start": 693.5,
      "end": 695.36,
      "text": "沒有那麼"
    },
    {
      "start": 695.36,
      "end": 696.86,
      "text": "鑽研過"
    },
    {
      "start": 696.86,
      "end": 698.1,
      "text": "可是你從第一次第二次"
    },
    {
      "start": 698.1,
      "end": 699.7,
      "text": "到第三次的時候"
    },
    {
      "start": 699.7,
      "end": 702.0,
      "text": "他修正速度超快"
    },
    {
      "start": 702.0,
      "end": 703.62,
      "text": "他是一個可以接受人家"
    },
    {
      "start": 703.62,
      "end": 705.72,
      "text": "告訴他你什麼做是正確的"
    },
    {
      "start": 708.12,
      "end": 710.82,
      "text": "蔣萬安他目前整體的比例來說"
    },
    {
      "start": 710.82,
      "end": 712.52,
      "text": "是52.9%"
    },
    {
      "start": 712.52,
      "end": 715.0600000000001,
      "text": "那沈伯洋是29.7%"
    },
    {
      "start": 715.06,
      "end": 718.1199999999999,
      "text": "新臺灣國策智庫7號發佈的民調"
    },
    {
      "start": 718.1199999999999,
      "end": 721.66,
      "text": "蔣萬安支持度壓倒性超過沈伯洋"
    },
    {
      "start": 721.66,
      "end": 724.9,
      "text": "就在這份碾壓性的民調數字公布後的6天"
    },
    {
      "start": 724.9,
      "end": 726.9599999999999,
      "text": "2026年5月13號"
    },
    {
      "start": 726.9599999999999,
      "end": 730.4,
      "text": "距離臺北市長投票日倒數199天"
    },
    {
      "start": 730.4,
      "end": 732.2199999999999,
      "text": "民進黨黨主席賴清德"
    },
    {
      "start": 732.2199999999999,
      "end": 735.5,
      "text": "親自替沈伯洋披上了競選揹帶"
    },
    {
      "start": 735.5,
      "end": 738.0999999999999,
      "text": "無論你的顏色為何"
    },
    {
      "start": 738.0999999999999,
      "end": 741.06,
      "text": "請讓我傾聽各位的聲音"
    },
    {
      "start": 741.06,
      "end": 745.0999999999999,
      "text": "請讓我有機會能夠跟各位站在一起"
    },
    {
      "start": 745.0999999999999,
      "end": 746.5999999999999,
      "text": "如果有人說"
    },
    {
      "start": 746.5999999999999,
      "end": 749.6999999999999,
      "text": "懷抱希望是一種錯誤"
    },
    {
      "start": 749.6999999999999,
      "end": 752.76,
      "text": "那麼我會每一次都反駁他"
    },
    {
      "start": 752.76,
      "end": 756.16,
      "text": "無論幾次我都會堅定的說"
    },
    {
      "start": 756.16,
      "end": 759.2199999999999,
      "text": "未來的事情無人知曉"
    },
    {
      "start": 759.2199999999999,
      "end": 761.06,
      "text": "但就是因為這樣"
    },
    {
      "start": 761.06,
      "end": 763.8,
      "text": "可能性才會如此強大"
    },
    {
      "start": 763.8,
      "end": 764.92,
      "text": "我是沈伯洋"
    },
    {
      "start": 764.92,
      "end": 767.5,
      "text": "我決定參選臺北市長"
    },
    {
      "start": 767.5,
      "end": 768.6199999999999,
      "text": "我是沈伯洋"
    },
    {
      "start": 768.6199999999999,
      "end": 770.42,
      "text": "請讓我成為你的市長"
    },
    {
      "start": 770.42,
      "end": 776.86,
      "text": "作為一個完全沒有任何選舉經驗的素人"
    },
    {
      "start": 776.86,
      "end": 778.88,
      "text": "沈伯洋他以平淡的語氣"
    },
    {
      "start": 778.88,
      "end": 781.6999999999999,
      "text": "說出了這一段內容堅定的競選宣言"
    },
    {
      "start": 781.6999999999999,
      "end": 783.76,
      "text": "但沈伯洋心裡非常清楚"
    },
    {
      "start": 783.76,
      "end": 784.9399999999999,
      "text": "他只有一個請託"
    },
    {
      "start": 784.9399999999999,
      "end": 787.64,
      "text": "就是請大家幫忙把他介紹出去"
    },
    {
      "start": 787.64,
      "end": 789.8199999999999,
      "text": "剩下的就交給他了"
    },
    {
      "start": 789.8199999999999,
      "end": 792.5999999999999,
      "text": "他自己本身對統計學就很在行"
    },
    {
      "start": 792.5999999999999,
      "end": 794.9599999999999,
      "text": "所以他說只要有人認識我"
    },
    {
      "start": 794.9599999999999,
      "end": 797.5799999999999,
      "text": "我就有把握讓他支持"
    },
    {
      "start": 797.58,
      "end": 800.32,
      "text": "蔣萬安在這幾年的"
    },
    {
      "start": 800.32,
      "end": 802.0200000000001,
      "text": "他多少還是有些優點"
    },
    {
      "start": 802.0200000000001,
      "end": 802.82,
      "text": "哪裡"
    },
    {
      "start": 802.82,
      "end": 803.32,
      "text": "有"
    },
    {
      "start": 803.32,
      "end": 807.7,
      "text": "比如說他讓我想要來參選台北市長"
    },
    {
      "start": 807.7,
      "end": 811.6,
      "text": "因為我很相信他講了一句話"
    },
    {
      "start": 811.6,
      "end": 812.76,
      "text": "我來就是要贏"
    },
    {
      "start": 812.76,
      "end": 815.5600000000001,
      "text": "我要來輸的我幹嘛要來"
    },
    {
      "start": 815.5600000000001,
      "end": 816.5400000000001,
      "text": "應該是說"
    },
    {
      "start": 816.5400000000001,
      "end": 818.1,
      "text": "當他講出這個話的時候"
    },
    {
      "start": 818.1,
      "end": 819.5600000000001,
      "text": "我認為很多人都會覺得"
    },
    {
      "start": 819.5600000000001,
      "end": 821.0,
      "text": "你憑什麼覺得你會贏"
    },
    {
      "start": 821.0,
      "end": 822.24,
      "text": "一開始有人覺得"
    },
    {
      "start": 822.24,
      "end": 824.58,
      "text": "算了 臺北那麼難打"
    },
    {
      "start": 824.58,
      "end": 825.84,
      "text": "我們不要灰心"
    },
    {
      "start": 825.84,
      "end": 827.84,
      "text": "我們也不應該喪志"
    },
    {
      "start": 827.84,
      "end": 828.84,
      "text": "為什麼"
    },
    {
      "start": 828.84,
      "end": 829.84,
      "text": "因為你過來"
    },
    {
      "start": 829.84,
      "end": 833.84,
      "text": "我們一起把台北的答案"
    },
    {
      "start": 833.84,
      "end": 835.84,
      "text": "11月28號拜託大家"
    },
    {
      "start": 835.84,
      "end": 836.84,
      "text": "拜託"
    },
    {
      "start": 836.84,
      "end": 839.84,
      "text": "讓沈伯洋成為你的市長"
    },
    {
      "start": 839.84,
      "end": 841.84,
      "text": "當然你前面輸快30%"
    },
    {
      "start": 841.84,
      "end": 842.84,
      "text": "這個就叫做"
    },
    {
      "start": 842.84,
      "end": 843.84,
      "text": "你就是衝啊"
    },
    {
      "start": 843.84,
      "end": 845.84,
      "text": "你沒有什麼好想"
    },
    {
      "start": 845.84,
      "end": 846.84,
      "text": "你就是衝"
    },
    {
      "start": 846.84,
      "end": 847.84,
      "text": "我們有我們自己的步調"
    },
    {
      "start": 847.84,
      "end": 848.84,
      "text": "我們就是希望"
    },
    {
      "start": 848.84,
      "end": 849.84,
      "text": "我們能夠專注在"
    },
    {
      "start": 849.84,
      "end": 850.84,
      "text": "把臺北市變得更好"
    },
    {
      "start": 850.84,
      "end": 853.84,
      "text": "那它是一個選戰的節奏"
    },
    {
      "start": 853.84,
      "end": 854.84,
      "text": "它是一個選戰節奏"
    },
    {
      "start": 854.84,
      "end": 857.6,
      "text": "你每一期追到什麼樣的程度"
    },
    {
      "start": 857.6,
      "end": 859.14,
      "text": "看民調 為什麼要做民調"
    },
    {
      "start": 859.14,
      "end": 861.88,
      "text": "這就是你要改變你的選戰策略"
    },
    {
      "start": 861.88,
      "end": 863.6,
      "text": "越多人認識我們"
    },
    {
      "start": 863.6,
      "end": 865.9,
      "text": "我們就越有機會勝選"
